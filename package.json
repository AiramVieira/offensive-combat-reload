{
  "name": "offensive-combat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "bin": {
    "offensive": "tools/offensive.ts"
  },
  "scripts": {
    "dev": "vite",
    "dev:online": "bun tools/dev-online.ts",
    "server": "bun --watch server/index.ts",
    "build": "bun run typecheck && vite build && bun run build:server",
    "build:server": "bun build server/index.ts --target=bun --packages=external --outfile=build/server.js && bun build tools/admin.ts --target=bun --packages=external --outfile=build/admin.js",
    "start": "bun build/server.js",
    "start:dev": "bun server/index.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "exemplos:glb": "bun tools/gerar-props-exemplo.mjs",
    "admin": "bun tools/admin.ts",
    "offensive": "bun tools/offensive.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "arctic": "^3.7.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "recast-navigation": "^0.43.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@types/bun": "^1.4.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
